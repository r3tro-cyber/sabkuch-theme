        "label": "Enable RTL",
        "default": false
      },
      {
        "type": "text",
        "id": "language_support_rtl",
        "label": "Languages support RTL",
        "default": "he,ar",
        "info": "Enter ISO language code, separate by comma. Leave blank to enable for all languages. [Check ISO language code](https://www.loc.gov/standards/iso639-2/php/code_list.php)"
      },
      {
        "type": "checkbox",
        "id": "enable_back_to_top",
        "label": "Enable back to top button",
        "default": false
      }
    ]
  },
