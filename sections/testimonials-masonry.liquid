{{ 'component-testimonial.css' | asset_url | stylesheet_tag }}
{{ 'section-testimonials-masonry.css' | asset_url | stylesheet_tag }}
{% liquid
  assign columns_mobile_int = 1
  assign enable_swipe_mobile = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign enable_swipe_mobile = true
  endif

  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = 2

  if section.blocks.size < 2
    assign columns_desktop = 1
    assign columns_tablet = 1
  endif

  assign has_richtext = false
  if section.settings.heading != blank or section.settings.description != blank or section.settings.subheading != blank
    assign has_richtext = true
  endif

  assign header_empty = true
  if has_richtext
    assign header_empty = false
  endif

  assign header_alignment = section.settings.section_header_alignment
  assign header_alignment_mobile = section.settings.section_header_alignment_mobile
  if header_alignment_mobile == 'inherit'
    assign header_alignment_mobile = header_alignment
  endif

  assign card_has_bg = false
  if section.settings.color_scheme != section.settings.card_color_scheme
    assign card_has_bg = true
  endif

  assign motion_delay = 50
  assign max_height = section.settings.max_height
%}

{% style %}
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --f-columns-mobile: {{ columns_mobile_int }};
    --f-columns-md: {{ columns_tablet }};
    --f-columns-lg: {{ columns_desktop }};
  }
{% endstyle %}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div class="section section-{{ section.id }} section--padding testimonials-masonry color-{{ section.settings.color_scheme }}">
  <div class="section__container page-width page-width--{{ section.settings.container }}">
    {%- unless header_empty -%}
      <div class="section__header s__header rich-text rich-text--tight md:text-{{ header_alignment }} text-{{ header_alignment_mobile }} flex flex-col items-{{ header_alignment_mobile | replace: 'left', 'start' | replace: 'right', 'end' }} md:items-center{% unless header_alignment == 'center' %} md:flex-row{{ header_alignment | replace: 'left','' | replace: 'right','-reverse' }} gap-x-4{% endunless %}">
        {% if has_richtext %}
          <div class="section__header--text s__header--text rich-text rich-text--tight flex-1">
            {% if section.settings.subheading != blank %}
              <motion-element
                class="section__subheading text-subheading rich-text__subheading block"
                data-motion="fade-up"
                data-motion-delay="{{ motion_delay }}"
              >
                {{- section.settings.subheading -}}
              </motion-element>
              {%- assign motion_delay = motion_delay | plus: 50 -%}
            {% endif %}
            {% if section.settings.heading != blank %}
              <h2 class="rich-text__heading inline-richtext {{ section.settings.heading_size }}">
                <motion-element data-motion="fade-up" data-motion-delay="{{ motion_delay }}" class="block">
                  {% render 'highlight-text',
                    hl_text: section.settings.heading,
                    hl_style: section.settings.highlight_style,
                    hl_font_style: section.settings.highlight_font_style,
                    hl_style_color: section.settings.highlight_style_color,
                    hl_text_color: section.settings.highlight_text_color
                  %}
                </motion-element>
              </h2>
              {%- assign motion_delay = motion_delay | plus: 50 -%}
            {% endif %}
            {% if section.settings.description != blank %}
              <motion-element
                data-motion="fade-up"
                data-motion-delay="{{ motion_delay }}"
                class="block rich-text__text rte {{ section.settings.text_size }} text-subtext"
              >
                {{- section.settings.description -}}
              </motion-element>
              {%- assign motion_delay = motion_delay | plus: 50 -%}
            {% endif %}
          </div>
        {% endif %}
      </div>
    {%- endunless -%}
    <div class="section__content relative">
      <show-more
        class="read-more__text block"
        data-toggle-class="overflow-hidden"
        data-show-text="{{ 'accessibility.show_more' | t }}"
        data-hide-text="{{ 'accessibility.show_less' | t }}"
        data-section-id="{{ section.id }}"
        data-swipe-mobile="{{ enable_swipe_mobile }}"
        data-max-height="{{ max_height }}"
        data-disable-on-mobile="true"
        is="read-more"
      >
        <div
          class="read-more__content testimonials-masonry__wrapper{% if enable_swipe_mobile %} swipe-mobile swipe-mobile--{{ columns_mobile_int }}-cols{% endif %}"
          id="testimonials-masonry-{{ section.id }}"
        >
          <masonry-layout
            class="testimonials-masonry__items f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}{% if enable_swipe_mobile %} swipe-mobile__inner{% endif %}"
          >
            {%- for block in section.blocks -%}
              <div
                class="f-column"
                {{ block.shopify_attributes }}
                data-index="{{ forloop.index0 }}"
              >
                {% render 'testimonial-2',
                  card_text_size: 'text-base',
                  block: block,
                  color_scheme: section.settings.card_color_scheme,
                  has_bg: card_has_bg,
                  image_ratio: section.settings.card_image_ratio,
                  index: forloop.index
                %}
              </div>
            {%- endfor -%}
          </masonry-layout>
        </div>
        <div class="read-more__btn{% if max_height > 0 %} hidden md:flex justify-center{% else %} hidden{% endif %}">
          <button class="read-more__toggle btn btn--primary">
            <span class="btn__text">{{ 'accessibility.view_more' | t }}</span>
          </button>
        </div>
      </show-more>
      {% if enable_swipe_mobile and section.settings.show_progress_bar %}
        <scroll-progress-bar class="md:hidden" target="testimonials-masonry-{{ section.id }}">
          <div class="progress-container">
            <div class="progress-bar no-empty"></div>
          </div>
        </scroll-progress-bar>
      {% endif %}
    </div>
  </div>
</div>

