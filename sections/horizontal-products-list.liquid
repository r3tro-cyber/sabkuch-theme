{%- liquid
  assign button_style = section.settings.button_style
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign button_icon = section.settings.button_icon

  assign columns_desktop = section.settings.columns
  assign columns_latop = 3 | at_most: columns_desktop
  assign columns_tablet = 2 | at_most: columns_desktop

  assign columns_mobile = section.settings.columns_mobile | plus: 0

  assign collection = collections[section.settings.collection]
  if collection == blank and collections['all'].products.size > 0
    assign collection = collections['all']
  endif
  assign products_to_display = section.settings.limit
  if collection != blank and collection.all_products_count < products_to_display
    assign products_to_display = collection.all_products_count
  endif

  assign max_height = section.settings.max_height
  assign max_height_mobile = section.settings.max_height_mobile
-%}

{% style %}
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --f-columns-mobile: {{ columns_mobile }};
    --f-columns-md: {{ columns_tablet }};
    --f-columns-lg: {{ columns_latop }};
    --f-columns-xl: {{ columns_desktop }};
  }
{% endstyle %}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<div
  class="section section-{{ section.id }} horizontal-products-list section--padding color-{{ section.settings.color_scheme }}"
  data-id="{{ section.id }}"
>
  <div class="section__container page-width page-width--{{ section.settings.container }}">
    <div
      class="section__wrapper"
      data-section-id="{{ section.id }}"
    >
      {% render 'section-heading',
        section_settings: section.settings,
        description_size: section.settings.text_size,
        button_visible: true,
        button_link: button_link,
        button_style: button_style,
        button_icon: button_icon,
        button_label: button_label
      %}
      <div class="section__content">
        <show-more
          class="read-more__text block"
          data-toggle-class="overflow-hidden"
          data-show-text="{{ 'accessibility.show_more' | t }}"
          data-hide-text="{{ 'accessibility.show_less' | t }}"
          data-section-id="{{ section.id }}"
          data-max-height="{{ max_height }}"
          data-max-height-mobile="{{ max_height_mobile }}"
          data-disable-on-mobile="false"
          is="read-more"
        >
          <div class="read-more__content horizontal-products-list__wrapper">
            <div class="horizontal-products-list__items products-list f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}">
              {%- for product in collection.products limit: products_to_display -%}
                <div class="f-column">
                  {%- render 'card-product-horizontal',
                    product: product,
                    parent_color_scheme: section.settings.color_scheme,
                    button_type: section.settings.pcard_button_type,
                    title_line_limit: section.settings.pcard_title_line_limit,
                    section_index: section.index,
                    index: forloop.index
                  -%}
                </div>
              {%- else -%}
                {%- for i in (1..products_to_display) -%}
                  <div class="f-column">
                    {% render 'card-product-placeholder',
                      image_ratio: section.settings.pcard_image_ratio,
                      pcard_style: 'standard',
                      parent_color_scheme: section.settings.color_scheme,
                      horizontal_layout: true,
                      current: forloop.index,
                      index: forloop.index
                    %}
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="read-more__btn{% if max_height > 0 %} md:flex{% else %} md:hidden{% endif %}{% if max_height_mobile > 0 %} flex{% else %} hidden{% endif %} justify-center">
            <button class="read-more__toggle btn btn--primary">
              <span class="btn__text">{{ 'accessibility.view_more' | t }}</span>
            </button>
          </div>
        </show-more>
      </div>
    </div>
  </div>
</div>
<script src="{{ 'featured-collection.js' | asset_url }}" defer="defer"></script>
