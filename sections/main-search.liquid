{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_filter_size = 0
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = 3
  assign columns_mobile = section.settings.columns_mobile | times: 1

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor

  assign enable_layout_switching = section.settings.enable_layout_switching
  assign enable_sorting = section.settings.enable_sorting
  assign enable_filtering = section.settings.enable_filtering
  assign filter_type = section.settings.filter_type
  assign show_toolbar = false
  if enable_filtering or enable_sorting or enable_layout_switching
    assign show_toolbar = true
  endif
-%}
{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ columns_mobile }}),
(max-width: 1279px) calc((100vw - 90px) / {{ columns_tablet }}),
{%- if enable_filtering -%}
  calc({{ settings.page_width}}px / {{ columns_desktop | plus: 1 }})
{%- else -%}
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endif -%}
{%- endcapture -%}
<div
  class="collection {{ section.index }} page-width page-width--{{ section.settings.container }} template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section--padding color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div data-motion="fade-up" class="template-search__header grid gap-6">
    <h1 class="h2 text-center" tabindex="-1">
      <motion-element class="block" data-motion="fade-up">
        {%- if search.performed -%}
          {{- 'templates.search.title' | t -}}
        {%- else -%}
          {{- 'general.search.search' | t -}}
        {%- endif -%}
      </motion-element>
    </h1>
    <div class="template-search__search flex items-center justify-center relative">
      {%- render 'predictive-search', context: 'page' -%}
    </div>
    {%- if search.performed -%}
      {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
        {%- if search.results_count > 0 -%}
          <p role="status" class="m-0 text-center">
            {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
          </p>
        {%- endif -%}
      {%- endunless -%}
      {%- if search.results_count == 0 and search.filters == empty -%}
        <div class="text-center grid gap-1">
          <h4>{{ 'templates.search.no_results_text' | t: terms: search.terms }}</h4>
          <p class="m-0">{{ 'templates.search.no_results_message' | t }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
  {% paginate search.results by section.settings.products_per_page %}
    {%- if search.results_count > 0 -%}
      <div class="sticky-element grid gap-5 z-9" style="--sticky-offset: 0px;">
        {%- if show_toolbar -%}
          <div class="collection__toolbar flex flex-wrap items-end md:items-center justify-between gap-x-2">
            <div class="collection__toolbar-left flex md:items-center flex-col md:flex-row">
              <div data-facet-loading class="md:order-last">
                {%- render 'loading-spinner' -%}
                <p id="ProductCount" class="m-0 text-subtext" role="status">
                  {%- liquid
                    if search.results_count
                      echo 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count
                    elsif search.products_count == search.results_count
                      echo 'products.facets.product_count_simple' | t: count: search.products_count
                    else
                      echo 'products.facets.product_count' | t: product_count: search.products_count, count: search.results_count
                    endif
                  -%}
                </p>
              </div>
              {%- if enable_filtering -%}
                {%- render 'facets-drawer',
                  results: search,
                  enable_sorting: enable_sorting,
                  filter_type: filter_type
                -%}
              {%- endif -%}
            </div>
            <div class="collection__toolbar-right flex items-end md:items-center flex-col md:flex-row">
              {%- if enable_sorting -%}
                <div class="hidden no-js-hidden lg:flex items-center gap-2" id="SortByContainer">
                  {%- render 'facet-short', results: search, label_class: 'font-body-bolder', context: 'search' -%}
                </div>
              {%- endif -%}
              {%- if enable_layout_switching -%}
                <layout-switcher class="flex items-center gap-2 shrink-0">
                  <span class="hidden md:block font-body-bolder">
                    {{- 'accessibility.layout_switcher.view_as' | t }}:</span
                  >
                  <button
                    class="btn btn--icon-circle btn--icon btn--active"
                    data-layout-mode="grid"
                    aria-label="{{ 'accessibility.layout_switcher.grid' | t }}"
                  >
                    <span class="btn__text flex gap-1 items-center">
                      {%- render 'icon-grid-four', size: 'large' -%}
                    </span>
                  </button>
                  <button
                    class="btn btn--icon-circle btn--icon"
                    data-layout-mode="list"
                    aria-label="{{ 'accessibility.layout_switcher.list' | t }}"
                  >
                    <span class="btn__text flex gap-1 items-center">
                      {%- render 'icon-list-dashes', size: 'large' -%}
                    </span>
                  </button>
                </layout-switcher>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
      {%- liquid
        if enable_filtering
          render 'facets-active', results: search
        endif
      -%}
    {%- endif -%}
    <div class="collection__content flex">
      {%- if search.results_count > 0 -%}
        <div
          class="no-js-hidden hidden{% if enable_filtering and filter_type == 'vertical' %} xl:block{% endif %}"
          id="FacetFiltersContainer"
        >
          <div class="sticky-element z-8" style="--sticky-offset: 7.2rem;">
            {%- render 'facets', context: 'vertical', results: search -%}
          </div>
        </div>
      {%- endif -%}
      <div class="flex flex-col flex-grow" id="ProductGridWrapper">
        <div id="ProductGridContainer">
          {%- if search.results_count > 0 -%}
            <div
              id="ProductsList"
              class="grid-list products-list products-list--list-{{ settings.pcard_list_style }} f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}"
              style="--f-columns-mobile: {{ columns_mobile }}; --f-columns-md: {{ columns_tablet }}; --f-columns-xl: {{ columns_desktop }};"
              {% if settings.pcard_style == 'card' %}
                data-grid-class="color-{{ settings.pcard_color_scheme }}"
              {% endif %}
              {% if settings.pcard_list_style == 'card' %}
                data-list-class="color-{{ settings.pcard_color_scheme }}"
              {% endif %}
            >
              {%- for item in search.results -%}
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    <div class="f-column card">
                      {%- render 'card-product',
                        product: item,
                        parent_color_scheme: section.settings.color_scheme,
                        image_sizes: image_sizes,
                        section_id: section.id,
                        section_index: section.index,
                        index: forloop.index
                      -%}
                    </div>
                  {%- when 'article' -%}
                    <div class="f-column card">
                      <div
                        class="product-card product-card-style-{{ settings.pcard_style }}{% if settings.pcard_style == 'card' %} color-{{ settings.pcard_color_scheme }}{% endif %}"
                      >
                        {%- render 'card-article',
                          article: item,
                          title_size: 'text-pcard-title',
                          show_tags: section.settings.show_tags,
                          show_author: section.settings.show_author,
                          show_date: section.settings.show_date,
                          show_excerpt: section.settings.show_excerpt,
                          show_button: section.settings.show_button
                        -%}
                      </div>
                    </div>
                  {%- when 'page' -%}
                    <div class="f-column card">
                      <div
                        class="product-card product-card-style-{{ settings.pcard_style }}{% if settings.pcard_style == 'card' %} color-{{ settings.pcard_color_scheme }}{% endif %}"
                      >
                        <div class="product-card__wrapper h-full">
                          <a href="{{ item.url }}" class="full-width-link product-card__link">
                            <span class="visually-hidden">{{- item.title -}}</span>
                          </a>
                          <div class="product-card__info text-{{ settings.pcard_content_alignment }} h-full">
                            <h3 class="product-card__title text-pcard-title">{{- item.title -}}</h3>
                          </div>
                        </div>
                      </div>
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- liquid
            if paginate.pages > 1
              render 'pagination', paginate: paginate, type: section.settings.pagination
            endif
          -%}
        </div>
      </div>
    </div>
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "fixed",
          "label": "Fixed width"
        }
      ],
      "default": "fixed",
      "label": "Container"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "column_gap",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2xs",
          "label": "Extra extra small"
        },
        {
          "value": "extra-small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra-large",
          "label": "Extra large"
        }
      ],
      "default": "medium",
      "label": "Column gap"
    },
    {
      "type": "select",
      "id": "row_gap",
      "options": [
        {
          "value": "inherit",
          "label": "Same as the column gap"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "extra-small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra-large",
          "label": "Extra large"
        }
      ],
      "default": "large",
      "label": "Row gap"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination",
      "options": [
        {
          "value": "infinite",
          "label": "Infinite"
        },
        {
          "value": "load_more",
          "label": "Load more button"
        },
        {
          "value": "number",
          "label": "Pagination by number"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Customize filters with the Search & Discovery app. [Learn more](https://help.shopify.com/manual/online-store/search-and-discovery/filters)"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "vertical",
      "label": "Desktop filter layout",
      "info": "Drawer is the default mobile layout."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_layout_switching",
      "default": true,
      "label": "Enable layout switching"
    },
    {
      "type": "text",
      "id": "expand_filter_groups",
      "label": "Expand filter groups",
      "placeholder": "Color, Price, Size",
      "info": "Each group filter is separated by a comma. Exam: Price, Color, Size"
    },
    {
      "type": "header",
      "content": "Blog card",
      "info": "Blog card styles also apply to page cards in search results. To change card styles update your theme settings."
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": false,
      "label": "Show excerpt"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "Show date"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": false,
      "label": "Show read more button"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    }
  ]
}
{% endschema %}
