      "content": "Section divider"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "Show divider"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "fixed",
      "label": "Divider width"
    }
  ],
  "presets": [
    {
      "name": "Quick comparison table",
      "blocks": [
        {
          "type": "info"
        },
        {
          "type": "description"
        },
        {
          "type": "price"
        },
        {
          "type": "variants"
        }
      ]
    }
  ]
}
{% endschema %}
