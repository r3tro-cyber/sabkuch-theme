          "label": "Thick underline"
        },
        {
          "value": "wave_underline",
          "label": "Wave underline"
        }
      ]
    },
    {
      "type": "select",
      "id": "highlight_font_style",
      "label": "Highlight font style",
      "options": [
        {
          "value": "italic",
          "label": "Italic"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ]
    },
    {
      "type": "color",
      "id": "highlight_style_color",
      "label": "Highlight style color"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "Highlight text color"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        {
          "value": "h5",
          "label": "Heading - Extra small"
        },
        {
          "value": "h4",
          "label": "Heading - Small"
        },
        {
          "value": "h3",
          "label": "Heading - Medium"
        },
        {
          "value": "h2",
          "label": "Heading - Large"
        },
        {
          "value": "h1",
          "label": "Heading - Extra large"
        },
        {
          "value": "hd2",
          "label": "Mega title - Base"
        },
        {
          "value": "hd1",
          "label": "Mega title - Large"
        }
      ]
