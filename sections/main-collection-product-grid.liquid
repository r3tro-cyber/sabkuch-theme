{{ 'collection.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
{%- render 'product-compare-bar' -%}
{%- liquid
  assign current_filter_size = 0
  assign columns_desktop = section.settings.columns_desktop
  assign columns_laptop = 4
  if columns_desktop < 4
      assign columns_laptop = columns_desktop
  endif
  assign columns_tablet = 3
  assign columns_mobile = section.settings.columns_mobile | times: 1

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor

  assign enable_layout_switching = section.settings.enable_layout_switching
  assign enable_sorting = section.settings.enable_sorting
  assign enable_filtering = section.settings.enable_filtering
  assign filter_type = section.settings.filter_type
  assign show_toolbar = false
  if enable_filtering or enable_sorting or enable_layout_switching
    assign show_toolbar = true
  endif

  assign block_size = section.blocks.size
  assign products_to_display = section.settings.products_per_page | minus: block_size
-%}
{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ columns_mobile }}),
(max-width: 1023px) calc((100vw - 90px) / {{ columns_tablet }}),
(max-width: 1279px) calc((100vw - 120px) / {{ columns_laptop }}),
{%- if enable_filtering -%}
  calc({{ settings.page_width}}px / {{ columns_desktop | plus: 1 }})
{%- else -%}
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endif -%}
{%- endcapture -%}
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<div
  class="collection section--padding page-width page-width--{{ section.settings.container }} color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- paginate collection.products by products_to_display -%}
    {%- if show_toolbar and collection.all_products_count > 0 -%}
      <div class="sticky-element grid gap-5 z-9" style="--sticky-offset: 0px;">
        <div class="collection__toolbar flex flex-wrap items-end md:items-center justify-between gap-x-2">
          <div class="collection__toolbar-left flex md:items-center flex-col md:flex-row">
            <div data-facet-loading class="md:order-last">
              {%- render 'loading-spinner' -%}
              <p id="ProductCount" class="m-0 text-subtext" role="status">
                {%- liquid
                  if collection.results_count
                    echo 'products.facets.filters_selected' | t: terms: collection.terms, count: collection.results_count
                  elsif collection.products_count == collection.all_products_count
                    echo 'products.facets.product_count_simple' | t: count: collection.products_count
                  else
                    echo 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                  endif
                -%}
              </p>
            </div>
            {%- if enable_filtering -%}
              {%- render 'facets-drawer',
                results: collection,
                enable_sorting: enable_sorting,
                filter_type: filter_type
              -%}
            {%- endif -%}
          </div>
          <div class="collection__toolbar-right flex items-end md:items-center flex-col md:flex-row">
            {%- if settings.enable_product_compare -%}
              <compare-switch class="flex items-center no-js-hidden">
                <input type="checkbox" id="ProductCompareSwitch" class="switch">
                <label for="ProductCompareSwitch" class="flex items-center gap-2">
                  <span class="text-nowrap font-body-bolder">
                    {{- 'products.product.compare' | t -}}
                    :</span
                  >
                  <span class="switch-slider"></span>
                </label>
              </compare-switch>
            {%- endif -%}
            {%- if enable_sorting -%}
              <div class="hidden no-js-hidden lg:flex items-center gap-2" id="SortByContainer">
                {%- render 'facet-short',
                  results: collection,
                  label_class: 'font-body-bolder',
                  context: 'collection'
                -%}
              </div>
            {%- endif -%}
            {%- if enable_layout_switching -%}
              <layout-switcher class="flex items-center gap-2 shrink-0 no-js-hidden">
                <span class="hidden md:block font-body-bolder">{{ 'accessibility.layout_switcher.view_as' | t }}:</span>
                <button
                  class="btn btn--icon btn--icon-circle btn--active"
                  data-layout-mode="grid"
                  aria-label="{{ 'accessibility.layout_switcher.grid' | t }}"
                >
                  <span class="btn__text flex gap-1 items-center">
                    {%- render 'icon-grid-four', size: 'large' -%}
                  </span>
                </button>
                <button
                  class="btn btn--icon btn--icon-circle"
                  data-layout-mode="list"
                  aria-label="{{ 'accessibility.layout_switcher.list' | t }}"
                >
                  <span class="btn__text flex gap-1 items-center">
                    {%- render 'icon-list-dashes', size: 'large' -%}
                  </span>
                </button>
              </layout-switcher>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    {%- liquid
      if enable_filtering
        render 'facets-active', results: collection
      endif
    -%}
    <div class="collection__content flex">
      {%- if collection.all_products_count > 0 -%}
        <div
          class="no-js-hidden hidden{% if enable_filtering and filter_type == 'vertical' %} xl:block{% endif %}"
          id="FacetFiltersContainer"
        >
          <div class="sticky-element z-8" style="--sticky-offset: 7.2rem;">
            {%- render 'facets', context: 'vertical', results: collection -%}
          </div>
        </div>
      {%- endif -%}
      <div class="flex flex-col flex-grow" id="ProductGridWrapper">
        <div id="ProductGridContainer">
          {%- if collection.products.size == 0 -%}
            <div class="empty-state flex flex-col items-center justify-center gap-6 text-center">
              {%- if collection.all_products_count > 0 -%}
                <div class="gap-3 flex flex-col items-center justify-center text-center">
                  {%- render 'icon-empty-state' -%}
                  <p class="h4">{{ 'collections.general.no_results' | t }}</p>
                  <p class="m-0">{{ 'collections.general.use_fewer_filters' | t }}</p>
                </div>
                <a class="btn btn--primary" href="{{ collection.url }}" is="facet-remove">
                  <span class="btn__text">{{- 'products.facets.clear_all' | t -}}</span>
                </a>
              {%- else -%}
                <div class="gap-3 flex flex-col items-center justify-center text-center">
                  {%- render 'icon-empty-state' -%}
                  <p class="h4">{{ 'collections.general.empty' | t }}</p>
                </div>
                <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
                  {{ 'collections.general.continue_shopping' | t }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div
            id="ProductsList"
            class="grid-list products-list products-list--list-{{ settings.pcard_list_style }} f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}"
            style="--f-columns-mobile: {{ columns_mobile }}; --f-columns-md: {{ columns_tablet }};--f-columns-lg: {{ columns_laptop }}; --f-columns-xl: {{ columns_desktop }};"
            {% if settings.pcard_style == 'card' %}
              data-grid-class="color-{{ settings.pcard_color_scheme }}"
            {% endif %}
            {% if settings.pcard_list_style == 'card' %}
              data-list-class="color-{{ settings.pcard_color_scheme }}"
            {% endif %}
          >
            {%- liquid
              assign current_position = 1
            -%}
            {%- for product in collection.products -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'image_card' and block.settings.image_position == current_position -%}
                  <div class="f-column image-column">
                    {% render 'card-image',
                      color_scheme: block.settings.color_scheme,
                      link: block.settings.card_link,
                      image: block.settings.image,
                      image_mobile: block.settings.image_mobile,
                      image_overlay_opacity: block.settings.image_overlay_opacity,
                      heading: block.settings.heading,
                      highlight_style: block.settings.highlight_style,
                      highlight_font_style: block.settings.highlight_font_style,
                      highlight_style_color: block.settings.highlight_style_color,
                      highlight_text_color: block.settings.highlight_text_color,
                      heading_size: block.settings.heading_size,
                      subheading: block.settings.subheading,
                      subheading_style: block.settings.subheading_style,
                      description: block.settings.description,
                      description_size: block.settings.text_size,
                      button_label: block.settings.button_label,
                      button_style: block.settings.button_style,
                      button_icon: block.settings.button_icon,
                      content_position: block.settings.content_position,
                      content_alignment: block.settings.content_alignment,
                      content_spacing: block.settings.content_spacing,
                      rich_text_size: block.settings.content_gap,
                      section_index: section.index,
                      forloop_index: current_position,
                      enable_preload_image: block.settings.enable_preload_image,
                      heading_size_custom: block.settings.heading_size_custom,
                      heading_size_mobile: block.settings.heading_size_mobile
                    %}
                  </div>
                  {% assign current_position = current_position | plus: 1 %}
                {%- endif -%}
              {%- endfor -%}

              <div class="f-column product-column">
                {%- render 'card-product',
                  product: product,
                  parent_color_scheme: section.settings.color_scheme,
                  enable_compare_checkbox: true,
                  image_sizes: image_sizes,
                  section_id: section.id,
                  section_index: 2,
                  index: forloop.index
                -%}
                {% assign current_position = current_position | plus: 1 %}
              </div>

              {%- for block in section.blocks -%}
                {%- if block.type == 'image_card' and block.settings.image_position == current_position -%}
                  <div class="f-column image-column">
                    {% render 'card-image',
                      color_scheme: block.settings.color_scheme,
                      link: block.settings.card_link,
                      image: block.settings.image,
                      image_overlay_opacity: block.settings.image_overlay_opacity,
                      heading: block.settings.heading,
                      highlight_style: block.settings.highlight_style,
                      highlight_font_style: block.settings.highlight_font_style,
                      highlight_style_color: block.settings.highlight_style_color,
                      highlight_text_color: block.settings.highlight_text_color,
                      heading_size: block.settings.heading_size,
                      subheading: block.settings.subheading,
                      subheading_style: block.settings.subheading_style,
                      description: block.settings.description,
                      description_size: block.settings.text_size,
                      button_label: block.settings.button_label,
                      button_style: block.settings.button_style,
                      button_icon: block.settings.button_icon,
                      content_position: block.settings.content_position,
                      content_alignment: block.settings.content_alignment,
                      content_spacing: block.settings.content_spacing,
                      rich_text_size: block.settings.content_gap,
                      section_index: section.index,
                      forloop_index: current_position,
                      enable_preload_image: block.settings.enable_preload_image
                    %}
                  </div>
                  {% assign current_position = current_position | plus: 1 %}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
          {%- liquid
            if paginate.pages > 1
              render 'pagination', paginate: paginate, type: section.settings.pagination
            endif
          -%}
        </div>
      </div>
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "class": "collection-section",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "fixed",
          "label": "Fixed width"
        }
      ],
      "default": "fixed",
      "label": "Container"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 20,
      "label": "Products per page",
      "info": "The number of products displayed will decrease based on the number of blocks added to this section"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "column_gap",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2xs",
          "label": "Extra extra small"
        },
        {
          "value": "extra-small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra-large",
          "label": "Extra large"
        }
      ],
      "default": "medium",
      "label": "Column gap"
    },
    {
      "type": "select",
      "id": "row_gap",
      "options": [
        {
          "value": "inherit",
          "label": "Same as the column gap"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "extra-small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra-large",
          "label": "Extra large"
        }
      ],
      "default": "large",
      "label": "Row gap"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination",
      "options": [
        {
          "value": "infinite",
          "label": "Infinite"
        },
        {
          "value": "load_more",
          "label": "Load more button"
        },
        {
          "value": "number",
          "label": "Pagination by number"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Customize filters with the Search & Discovery app. [Learn more](https://help.shopify.com/manual/online-store/search-and-discovery/filters)"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatch",
      "label": "Enable color swatches",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "vertical",
      "label": "Desktop filter layout",
      "info": "Drawer is the default mobile layout."
    },
    {
      "type": "text",
      "id": "expand_filter_groups",
      "label": "Expand filter groups",
      "placeholder": "Color, Price, Size",
      "info": "Each group filter is separated by a comma. Exam: Price, Color, Size"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_layout_switching",
      "default": true,
      "label": "Enable layout switching"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Section divider"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "Show divider"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "fixed",
      "label": "Divider width"
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image card",
      "limit": 3,
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-1"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "range",
          "id": "image_position",
          "min": 1,
          "max": 36,
          "step": 1,
          "default": 1,
          "label": "Image position",
          "info": "Ensure the position is less than or equal to the total number of products per page. Otherwise, this block will not appear"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "default": "adapt",
          "options": [
            {
              "value": "adapt",
              "label": "Adapt to image"
            },
            {
              "value": "1/1",
              "label": "Square (1:1)"
            },
            {
              "value": "3/4",
              "label": "Portrait (3:4)"
            },
            {
              "value": "4/3",
              "label": "Landscape (4:3)"
            }
          ]
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Image overlay opacity",
          "default": 0
        },
        {
          "type": "header",
          "content": "Content settings"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "group": "Standard",
              "label": "Top left",
              "value": "top-left"
            },
            {
              "group": "Standard",
              "label": "Top center",
              "value": "top-center"
            },
            {
              "group": "Standard",
              "label": "Top right",
              "value": "top-right"
            },
            {
              "group": "Standard",
              "label": "Middle left",
              "value": "middle-left"
            },
            {
              "group": "Standard",
              "label": "Middle center",
              "value": "middle-center"
            },
            {
              "group": "Standard",
              "label": "Middle right",
              "value": "middle-right"
            },
            {
              "group": "Standard",
              "label": "Bottom left",
              "value": "bottom-left"
            },
            {
              "group": "Standard",
              "label": "Bottom center",
              "value": "bottom-center"
            },
            {
              "group": "Standard",
              "label": "Bottom right",
              "value": "bottom-right"
            },
            {
              "group": "Split",
              "label": "Middle content",
              "value": "split-middle-content"
            },
            {
              "group": "Split",
              "label": "Bottom button",
              "value": "split-bottom-button"
            },
            {
              "group": "Split",
              "label": "Top subheading",
              "value": "split-top-subheading"
            }
          ],
          "default": "bottom-center"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content alignment",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "select",
          "id": "content_spacing",
          "label": "Content spacing",
          "default": "medium",
          "options": [
            {
              "value": "extra-small",
              "label": "Extra small"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "type": "select",
          "id": "content_gap",
          "label": "Content gap",
          "default": "fitted",
          "options": [
            {
              "value": "tight",
              "label": "Extra small"
            },
            {
              "value": "fitted",
              "label": "Small"
            },
            {
              "value": "standard",
              "label": "Medium"
            }
          ]
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card link"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "select",
          "id": "subheading_style",
          "label": "Subheading style",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "border",
              "label": "With border"
            },
            {
              "value": "thick-border",
              "label": "With thick border"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Image card",
          "info": "To add an animated highlight to text, simply wrap it in italics. Click the \"I\" button in the editor to toggle italics when highlighting text."
        },
        {
          "type": "select",
          "id": "highlight_style",
          "label": "Highlight style",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "hand_drawn_circle",
              "label": "Hand-drawn circle"
            },
            {
              "value": "thick_underline",
              "label": "Thick underline"
            },
            {
              "value": "wave_underline",
              "label": "Wave underline"
            }
          ]
        },
        {
          "type": "select",
          "id": "highlight_font_style",
          "label": "Highlight font style",
          "options": [
            {
              "value": "italic",
              "label": "Italic"
            },
            {
              "value": "normal",
              "label": "Normal"
            }
          ]
        },
        {
          "type": "color",
          "id": "highlight_style_color",
          "label": "Highlight style color"
        },
        {
          "type": "color",
          "id": "highlight_text_color",
          "label": "Highlight text color"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h3",
          "options": [
            {
              "value": "h5",
              "label": "Heading - Extra small"
            },
            {
              "value": "h4",
              "label": "Heading - Small"
            },
            {
              "value": "h3",
              "label": "Heading - Medium"
            },
            {
