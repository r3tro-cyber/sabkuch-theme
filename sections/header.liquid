      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "fixed",
          "label": "Fixed width"
        }
      ],
      "default": "fixed",
      "label": "Container"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_mobile",
      "label": "Mobile menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        {
          "value": "logo-left",
          "label": "Logo left"
        },
        {
          "value": "logo-center",
          "label": "Logo center"
        },
        {
          "value": "logo-left-search-center",
          "label": "Logo left, search center"
        }
      ]
    },
    {
      "type": "select",
      "id": "menu_trigger",
      "label": "Dropdown menu trigger",
      "options": [
        {
          "value": "click",
          "label": "Click"
        },
        {
          "value": "hover",
          "label": "Hover"
        }
      ],
      "default": "click"
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Header sticky",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "on-scroll-up",
          "label": "On scroll up"
        }
      ],
      "default": "always"
    },
    {
      "type": "checkbox",
      "id": "enable_collapse_on_scroll",
      "label": "Enable collapse on scrolling"
    },
    {
      "type": "checkbox",
      "id": "show_sperator_line",
      "label": "Show separator line",
      "default": true
    },
    {
      "type": "select",
      "id": "customer_account_style",
      "label": "Customer account style",
      "options": [
        {
          "value": "icon-only",
          "label": "Icon only"
        },
        {
          "value": "icon-with-text",
          "label": "Icon with text"
        }
      ],
      "default": "icon-with-text"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "checkbox",
      "id": "show_social_media_icons",
      "label": "Show media social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "info": "To add a country/region, go to your [market settings.](/admin/settings/markets)",
      "default": true
    },
    {
      "type": "header",
      "content": "Header top padding"
    },
    {
      "type": "range",
      "id": "header_top_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "header_top_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "color_scheme",
      "id": "navigation_color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "navigation_content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "navigation_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
