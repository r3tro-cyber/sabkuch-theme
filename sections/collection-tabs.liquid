        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        }
      ]
    },
    {
      "type": "select",
      "id": "collection_heading_size",
      "label": "Title size",
      "default": "h1",
      "options": [
        {
          "value": "h5",
          "label": "Heading - Extra small"
        },
        {
          "value": "h4",
          "label": "Heading - Small"
        },
        {
          "value": "h3",
          "label": "Heading - Medium"
        },
        {
          "value": "h2",
          "label": "Heading - Large"
        },
        {
          "value": "h1",
          "label": "Heading - Extra large"
        },
        {
          "value": "hd2",
          "label": "Mega title - Base"
        },
        {
          "value": "hd1",
          "label": "Mega title - Large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
