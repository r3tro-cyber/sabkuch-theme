      "label": "Highlight text color"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h5",
      "options": [
        {
          "value": "h6",
          "label": "Heading - Extra extra small"
        },
        {
          "value": "h5",
          "label": "Heading - Extra small"
        },
        {
          "value": "h4",
          "label": "Heading - Small"
        },
        {
          "value": "h3",
          "label": "Heading - Medium"
        },
        {
          "value": "h2",
          "label": "Heading - Large"
        },
        {
          "value": "h1",
          "label": "Heading - Extra large"
        },
        {
          "value": "hd2",
          "label": "Mega title - Base"
        },
        {
          "value": "hd1",
          "label": "Mega title - Large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Tabs settings"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
